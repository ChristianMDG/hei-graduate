index 0000000..c6f4d7d
--- /dev/null
+++ b/src/main/resources/templates/promotions.html
@@ -0,0 +1,61 @@
+<!DOCTYPE html>
+<html lang="fr" xmlns:th="http://www.thymeleaf.org">
+<head>
+  <meta charset="UTF-8" />
+  <title>HEI Graduate — Promotions</title>
+  <style>
+    body { font-family: sans-serif; max-width: 720px; margin: 40px auto; }
+    table { width: 100%; border-collapse: collapse; margin-top: 16px; }
+    th, td { text-align: left; padding: 8px; border-bottom: 1px solid #ddd; }
+    a { color: #1a5fb4; }
+    #top-bar { display: flex; justify-content: space-between; align-items: center; }
+    #empty { color: #666; margin-top: 16px; }
+  </style>
+</head>
+<body>
+  <div id="top-bar">
+    <h1>Promotions</h1>
+    <button id="logout-btn">Se déconnecter</button>
+  </div>
+
+  <table id="promotions-table" style="display:none;">
+    <thead>
+      <tr><th>Promotion</th><th>Année finale</th><th></th></tr>
+    </thead>
+    <tbody id="promotions-body"></tbody>
+  </table>
+  <p id="empty" style="display:none;">Aucune promotion pour le moment.</p>
+
+  <script th:src="@{/js/auth.js}"></script>
+  <script>
+    window.heiAuth.requireAuth();
+
+    document.getElementById("logout-btn").addEventListener("click", function () {
+      window.heiAuth.logout();
+    });
+
+    async function loadPromotions() {
+      const response = await window.heiAuth.authFetch("/api/promotions");
+      const promotions = await response.json();
+
+      if (promotions.length === 0) {
+        document.getElementById("empty").style.display = "block";
+        return;
+      }
+
+      const body = document.getElementById("promotions-body");
+      promotions.forEach(function (promotion) {
+        const row = document.createElement("tr");
+        row.innerHTML =
+          "<td>" + promotion.label + "</td>" +
+          "<td>" + promotion.finalAcademicYearLabel + "</td>" +
+          "<td><a href='/promotions/" + promotion.id + "'>Voir les diplômés</a></td>";
+        body.appendChild(row);
+      });
+      document.getElementById("promotions-table").style.display = "table";
+    }
+
+    loadPromotions();
+  </script>
+</body>
+</html>
